# ---------------------------------------------------------------------------
# AgentDesk AI — environment configuration
#
# Copy this file to `.env` (or `.env.local`) and fill in values. Everything
# here is OPTIONAL — the application runs in fully-offline "demo mode" with
# zero external credentials. See README.md and docs/ for details.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# Local demo (default, zero dependencies):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL + pgvector):
# DATABASE_URL="postgresql://user:pass@localhost:5432/agentdesk"

# --- Auth ---------------------------------------------------------------------
# Used to sign session cookies. Generate with: `openssl rand -base64 32`
AUTH_SECRET="dev-only-secret-change-me-in-production-00000000"

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Demo mode ----------------------------------------------------------------
# When true (default when unset), all external integrations run against
# deterministic in-process providers. Set to "false" to require live creds.
DEMO_MODE="true"

# --- AI -----------------------------------------------------------------------
# Leave unset to use the deterministic DemoProvider (no network, no cost).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional: OpenAI-compatible endpoint override for other models/gateways.
# OPENAI_BASE_URL=""

# --- Embeddings / RAG ---------------------------------------------------------
# "demo" uses a deterministic local embedder (default). "openai" uses
# text-embedding-3-small (requires OPENAI_API_KEY).
EMBEDDING_PROVIDER="demo"

# --- HubSpot CRM --------------------------------------------------------------
# Leave unset for the clearly-labelled DemoCRMProvider.
HUBSPOT_ACCESS_TOKEN=""
# Deal pipeline/stage are portal-specific. Leave blank to use the portal default;
# set both to route deals into an explicit pipeline/stage.
HUBSPOT_DEAL_PIPELINE_ID=""
HUBSPOT_DEAL_STAGE_ID=""
# Retry policy for HubSpot calls (429 / 5xx / network).
HUBSPOT_MAX_ATTEMPTS="4"
HUBSPOT_RETRY_BASE_MS="500"

# --- WhatsApp Cloud API --------------------------------------------------------
# Leave unset for the Web Chat + demo provider.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Shared secret used to verify Meta webhook signatures (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""

# --- n8n -----------------------------------------------------------------------
# Leave unset for the local demo provider.
# Single authenticated entry webhook (AgentDesk -> n8n).
N8N_WEBHOOK_URL=""
# Shared secret: sent as x-agentdesk-secret (n8n Header Auth) and used to HMAC-sign events.
N8N_WEBHOOK_SECRET=""

# --- Google Drive --------------------------------------------------------------
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=""
