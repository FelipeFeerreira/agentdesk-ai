{
  "name": "AgentDesk — Qualified Lead",
  "nodes": [
    {
      "parameters": {},
      "id": "a0-trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    { \"filters\": [ { \"propertyName\": \"email\", \"operator\": \"EQ\", \"value\": \"{{ $json.payload.email }}\" } ] }\n  ],\n  \"properties\": [\"email\", \"firstname\", \"lastname\", \"company\"],\n  \"limit\": 1\n}",
        "options": {}
      },
      "id": "a2-search",
      "name": "Search Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "cond-found", "leftValue": "={{ $json.results.length }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a3-if",
      "name": "Contact Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{ $json.results[0].id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"firstname\": \"{{ $('When Executed by Another Workflow').item.json.payload.firstName }}\",\n    \"lastname\": \"{{ $('When Executed by Another Workflow').item.json.payload.lastName }}\",\n    \"company\": \"{{ $('When Executed by Another Workflow').item.json.payload.company }}\"\n  }\n}",
        "options": {}
      },
      "id": "a4-update",
      "name": "Update Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, -120],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"email\": \"{{ $('When Executed by Another Workflow').item.json.payload.email }}\",\n    \"firstname\": \"{{ $('When Executed by Another Workflow').item.json.payload.firstName }}\",\n    \"lastname\": \"{{ $('When Executed by Another Workflow').item.json.payload.lastName }}\",\n    \"company\": \"{{ $('When Executed by Another Workflow').item.json.payload.company }}\"\n  }\n}",
        "options": {}
      },
      "id": "a5-create",
      "name": "Create Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 120],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "cid", "name": "contactId", "value": "={{ $json.id }}", "type": "string" },
            { "id": "email", "name": "email", "value": "={{ $('When Executed by Another Workflow').item.json.payload.email }}", "type": "string" },
            { "id": "company", "name": "company", "value": "={{ $('When Executed by Another Workflow').item.json.payload.company }}", "type": "string" },
            { "id": "budget", "name": "budget", "value": "={{ $('When Executed by Another Workflow').item.json.payload.budget }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a6-set",
      "name": "Capture Contact",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/deals",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"dealname\": \"{{ $json.company }} — AI customer support\",\n    \"amount\": \"{{ $json.budget }}\",\n    \"pipeline\": \"{{ $env.HUBSPOT_DEAL_PIPELINE_ID }}\",\n    \"dealstage\": \"{{ $env.HUBSPOT_DEAL_STAGE_ID }}\"\n  }\n}",
        "options": {}
      },
      "id": "a7-deal",
      "name": "Create Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.hubapi.com/crm/v4/objects/deals/{{ $json.id }}/associations/default/contacts/{{ $('Capture Contact').item.json.contactId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a8-assoc",
      "name": "Associate Contact with Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "channelId": "={{ $env.SLACK_CHANNEL_ID }}",
        "text": "=New qualified lead: {{ $('Capture Contact').item.json.company }} — {{ $('Capture Contact').item.json.email }}",
        "credential": "slackApi",
        "otherOptions": {}
      },
      "id": "a9-slack",
      "name": "Notify Sales Team (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1560, 0],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{ "node": "Search Contact", "type": "main", "index": 0 }]]
    },
    "Search Contact": {
      "main": [[{ "node": "Contact Found?", "type": "main", "index": 0 }]]
    },
    "Contact Found?": {
      "main": [
        [{ "node": "Update Contact", "type": "main", "index": 0 }],
        [{ "node": "Create Contact", "type": "main", "index": 0 }]
      ]
    },
    "Update Contact": {
      "main": [[{ "node": "Capture Contact", "type": "main", "index": 0 }]]
    },
    "Create Contact": {
      "main": [[{ "node": "Capture Contact", "type": "main", "index": 0 }]]
    },
    "Capture Contact": {
      "main": [[{ "node": "Create Deal", "type": "main", "index": 0 }]]
    },
    "Create Deal": {
      "main": [[{ "node": "Associate Contact with Deal", "type": "main", "index": 0 }]]
    },
    "Associate Contact with Deal": {
      "main": [[{ "node": "Notify Sales Team (Slack)", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
