{
  "name": "AgentDesk — Knowledge Base Update",
  "nodes": [
    {
      "parameters": {
        "triggerOn": "webhook",
        "webhook": {
          "event": "fileCreated",
          "options": {}
        }
      },
      "id": "c1-drive",
      "name": "Google Drive Trigger (file created)",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "credentials": { "googleApi": { "id": "1", "name": "Google Drive OAuth2" } }
    },
    {
      "parameters": {
        "fileId": "={{ $json.id }}",
        "options": {}
      },
      "id": "c2-download",
      "name": "Google Drive Download",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [240, 0],
      "credentials": { "googleApi": { "id": "1", "name": "Google Drive OAuth2" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_URL}}/api/webhooks/n8n",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"kb_ingestion\",\n  \"payload\": {\n    \"title\": \"{{ $json.name }}\",\n    \"content\": \"{{ $json.data }}\"\n  }\n}"
      },
      "id": "c3-ingest",
      "name": "Send to AgentDesk Ingestion Endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Google Drive Trigger (file created)": {
      "main": [[{ "node": "Google Drive Download", "type": "main", "index": 0 }]]
    },
    "Google Drive Download": {
      "main": [[{ "node": "Send to AgentDesk Ingestion Endpoint", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
