{
  "name": "AgentDesk — Knowledge Base Update",
  "nodes": [
    {
      "parameters": {},
      "id": "c0-trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalize the knowledge payload into a fresh ingestion event.\nconst e = $json;\nreturn {\n  json: {\n    eventId: `evt_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 10)}`,\n    type: 'KNOWLEDGE_UPDATE',\n    version: 1,\n    organizationId: e.organizationId,\n    timestamp: new Date().toISOString(),\n    payload: {\n      title: e.payload.title,\n      content: e.payload.content ?? e.payload.text ?? '',\n      source: e.payload.source ?? 'n8n',\n      contentHash: e.payload.contentHash\n    }\n  }\n};"
      },
      "id": "c1-build",
      "name": "Build Ingestion Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-agentdesk-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "c2-ingest",
      "name": "Send to AgentDesk Ingestion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{ "node": "Build Ingestion Event", "type": "main", "index": 0 }]]
    },
    "Build Ingestion Event": {
      "main": [[{ "node": "Send to AgentDesk Ingestion", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
