{
  "name": "AgentDesk — Support Escalation",
  "nodes": [
    {
      "parameters": {},
      "id": "b0-trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "reason", "name": "reason", "value": "={{ $json.payload.reason }}", "type": "string" },
            { "id": "summary", "name": "summary", "value": "={{ $json.payload.summary }}", "type": "string" },
            { "id": "conversationId", "name": "conversationId", "value": "={{ $json.payload.conversationId }}", "type": "string" },
            { "id": "priority", "name": "priority", "value": "={{ $json.payload.priority }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b1-set",
      "name": "Normalize Escalation",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "channelId": "={{ $env.SLACK_CHANNEL_ID }}",
        "text": "=Escalation ({{ $json.priority }}): {{ $json.reason }} — {{ $json.summary }} [conv {{ $json.conversationId }}]",
        "credential": "slackApi",
        "otherOptions": {}
      },
      "id": "b2-slack",
      "name": "Notify Support Team (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{ "node": "Normalize Escalation", "type": "main", "index": 0 }]]
    },
    "Normalize Escalation": {
      "main": [[{ "node": "Notify Support Team (Slack)", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
