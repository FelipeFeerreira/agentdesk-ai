{
  "name": "AgentDesk — Lead Follow-up",
  "nodes": [
    {
      "parameters": {},
      "id": "d0-trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "amount": "={{ $json.payload.followUpDelayHours }}",
        "unit": "hours"
      },
      "id": "d1-wait",
      "name": "Wait for follow-up delay",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [220, 0],
      "webhookId": "agentdesk-followup-wait"
    },
    {
      "parameters": {
        "channelId": "={{ $env.SLACK_CHANNEL_ID }}",
        "text": "=Follow-up due: {{ $json.payload.company || $json.payload.email }} has not responded. Contact {{ $json.payload.email }}.",
        "credential": "slackApi",
        "otherOptions": {}
      },
      "id": "d2-slack",
      "name": "Notify Sales Team (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{ "node": "Wait for follow-up delay", "type": "main", "index": 0 }]]
    },
    "Wait for follow-up delay": {
      "main": [[{ "node": "Notify Sales Team (Slack)", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
